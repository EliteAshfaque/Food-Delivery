PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=your-long-random-jwt-secret
UPLOADTHING_TOKEN=your-uploadthing-token
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Optional browser-origin allow-list for the Socket.IO /orders namespace.
# Native Expo clients do not send an Origin header and are protected by JWT +
# room authorization instead. Separate multiple browser origins with commas.
# SOCKET_CORS_ORIGIN=https://app.example.com,https://admin.example.com
