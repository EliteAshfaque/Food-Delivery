PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=your-long-random-jwt-secret
UPLOADTHING_TOKEN=your-uploadthing-token
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# One-time, deployer-controlled first-admin bootstrap. Set this to an existing
# account email, restart the API once, then remove it from deployment secrets.
# There is deliberately no public endpoint for creating ADMIN accounts.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# Required only if you deploy a browser client (for example, a web admin
# portal). List the exact HTTPS origins separated by commas. Native mobile
# applications do not need this.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Set only when the API sits behind one trusted reverse proxy/load balancer.
# It lets the authentication rate limiter use the real client IP safely.
# TRUST_PROXY=true

UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# The same Upstash Redis is used for short-lived restaurant catalogue caching.
# If either value is omitted, the API safely falls back to PostgreSQL reads.

# Optional browser-origin allow-list for the Socket.IO /orders namespace.
# Native Expo clients do not send an Origin header and are protected by JWT +
# room authorization instead. Separate multiple browser origins with commas.
# SOCKET_CORS_ORIGIN=https://app.example.com,https://admin.example.com

# Optional driver-offer lease in seconds (minimum 30; defaults to 90). An
# unanswered pickup request is automatically returned to the dispatch queue.
# DRIVER_OFFER_LEASE_SECONDS=90

# Optional direct Android Firebase Cloud Messaging (FCM) HTTP v1 delivery.
# Use this when the mobile app registers an `android:fcm:<native-token>` rather
# than an ExpoPushToken. Create/download a Firebase service-account key for the
# SAME Firebase project as apps/mobile/google-services.json, then keep it only
# in your API/deployment secret store — never in mobile .env or Git.
#
# Base64 is preferred because it preserves the JSON private-key newlines in
# deployment dashboards. Example command (do not commit its output):
# base64 < firebase-service-account.json | tr -d '\n'
# FIREBASE_PROJECT_ID=food-delivery-d0d85
# Recommended for a local server: absolute path to a downloaded secret file.
# Keep the file outside this repository and restrict its permissions.
# FIREBASE_SERVICE_ACCOUNT_FILE=/secure/path/firebase-service-account.json
#
# Or provide the same JSON as a Base64 environment value:
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json
#
# Alternatively set the entire compact JSON document as one environment value:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
