# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Firebase/Admin credentials must never be committed. The API supports an
# absolute file path outside this repository; these patterns protect against
# accidentally downloading a service-account key into the API folder.
firebase-service-account*.json
*firebase-adminsdk*.json

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
