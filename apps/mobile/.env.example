# Production only — dev picks the URL automatically per platform.
# EXPO_PUBLIC_API_URL=https://api.yourapp.com/api
# EXPO_PUBLIC_SERVER_URL=https://api.yourapp.com

# Optional: override dev host (physical Android phone on same Wi‑Fi)
# Find your Mac IP: System Settings → Network, or run: ipconfig getifaddr en0
# EXPO_PUBLIC_DEV_HOST=192.168.1.5

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
