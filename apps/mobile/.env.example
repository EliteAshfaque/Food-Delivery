# Production only — dev picks the URL automatically per platform.
# EXPO_PUBLIC_API_URL=https://api.yourapp.com/api
# EXPO_PUBLIC_SERVER_URL=https://api.yourapp.com

# Optional: override dev host (physical Android phone on same Wi‑Fi)
# Find your Mac IP: System Settings → Network, or run: ipconfig getifaddr en0
# EXPO_PUBLIC_DEV_HOST=192.168.1.5

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Required for Expo remote push notifications in a development or release build.
# Run `npx eas init` from apps/mobile, then copy the Expo EAS project UUID here.
# This is NOT the Firebase project ID from google-services.json.
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Android-only alternative to Expo Push. Use the API's Firebase HTTP v1 sender
# with the native FCM token (useful while testing Firebase Console/FCM directly).
# Leave unset to prefer Expo Push when an EAS project ID is configured.
# EXPO_PUBLIC_ANDROID_PUSH_PROVIDER=fcm
